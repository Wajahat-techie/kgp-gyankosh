# ==============================================================================
# KGP Gyankosh - Environment Configuration Template (.env.example)
# Kashmir Government Polytechnic College, Srinagar - Administration Department
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM BACKEND CONFIGURATION (Switchable Local vs Cloud API)
# ------------------------------------------------------------------------------
# Options: 'ollama' (fully local, zero-cost, default) or 'openai' (API key required)
LLM_PROVIDER=ollama

# Ollama Local Configuration (Active when LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.1:latest
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# OpenAI Configuration (Active when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Alternative (Active if choosing google provider)
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. EMBEDDINGS CONFIGURATION
# ------------------------------------------------------------------------------
# Options: 'sentence-transformers' (local, default) or 'openai'
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 3. RERANKER CONFIGURATION
# ------------------------------------------------------------------------------
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true
TOP_K_RETRIEVAL=10
TOP_N_RERANK=4

# ------------------------------------------------------------------------------
# 4. HYBRID SEARCH WEIGHTS (Reciprocal Rank Fusion / Alpha)
# ------------------------------------------------------------------------------
# Balance between Vector (Dense) and BM25 (Sparse Keyword) search:
# 0.0 = Pure BM25, 1.0 = Pure Vector, 0.5 = Balanced Hybrid
HYBRID_ALPHA=0.5
RRF_K_CONSTANT=60

# ------------------------------------------------------------------------------
# 5. CHUNKING PARAMETERS
# ------------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ------------------------------------------------------------------------------
# 6. PATHS & STORAGE
# ------------------------------------------------------------------------------
# Default sample directory: data/sample_notices
# User main documents folder: ../Documents (contains pdf/ and word/ subfolders)
DATA_DIR=../Documents
VECTOR_STORE_DIR=output/vector_store
BM25_STORE_DIR=output/bm25_store
INDEX_LOG_DIR=output/index_logs
AUTH_CONFIG_PATH=config/auth_config.yaml

# ------------------------------------------------------------------------------
# 7. OCR CONFIGURATION (Tesseract & Poppler paths on Windows/Linux)
# Leave blank to use system PATH, or specify exact binary paths
# ------------------------------------------------------------------------------
# Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Windows poppler bin folder e.g.: C:\poppler\Library\bin
POPPLER_PATH=
ENABLE_OCR=true
